# Copy this file to `.env` and fill in the values from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
# `.env` is gitignored; this template is not.
#
# The Transfer tab is disabled until these are set. Everything else in the app
# (formatter, text extractor) works without them.
#
# Walkthrough: see "Setting up Firebase" in README.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
# Realtime Database URL. Copy it EXACTLY from the console
# (Realtime Database -> the URL above the data tree), including any region
# such as `europe-west1`. The SDK does not infer this from the project ID.
# If omitted, `https://<project-id>-default-rtdb.firebaseio.com` is assumed.
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional WebRTC overrides.
# A TURN relay is only needed when both peers are behind symmetric NATs, which
# blocks the direct connection that STUN alone can negotiate.
# VITE_WEBRTC_STUN=stun.l.google.com:19302
# VITE_WEBRTC_TURN_URL=turn:your-turn-host:3478
# VITE_WEBRTC_TURN_USERNAME=
# VITE_WEBRTC_TURN_CREDENTIAL=